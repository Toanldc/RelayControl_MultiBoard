<Window x:Class="RelayControlWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Relay Control"
        Height="780" Width="760"
        ResizeMode="CanMinimize"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Connection mode -->
            <RowDefinition Height="Auto"/>  <!-- Connection card -->
            <RowDefinition Height="*"/>     <!-- Tabs -->
        </Grid.RowDefinitions>

        <!-- ==================== HEADER ==================== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Relay Control" Style="{StaticResource TitleText}"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource DangerBrush}"
                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock x:Name="StatusText" Text="Not connected" Style="{StaticResource SubtitleText}"/>
            </StackPanel>
        </StackPanel>

        <!-- ==================== CONNECTION MODE ==================== -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton x:Name="SerialModeRadio" Content="UART (Serial)" GroupName="ConnMode"
                         Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                         Margin="0,0,20,0" Checked="ModeRadio_Checked"/>
            <RadioButton x:Name="BleModeRadio" Content="Bluetooth (BLE)" GroupName="ConnMode"
                         Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                         Checked="ModeRadio_Checked"/>
        </StackPanel>

        <!-- ==================== CONNECTION CARD ==================== -->
        <Border Grid.Row="2" Background="{StaticResource CardBrush}" CornerRadius="14"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
                Padding="16" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="PortComboBox" Grid.Column="0" Style="{StaticResource DarkComboBox}"
                          Margin="0,0,8,0" VerticalAlignment="Center" VerticalContentAlignment="Center"
                          Foreground="{StaticResource TextPrimaryBrush}"/>

                <ComboBox x:Name="BleDeviceComboBox" Grid.Column="0" Style="{StaticResource DarkComboBox}"
                          Margin="0,0,8,0" VerticalAlignment="Center" VerticalContentAlignment="Center"
                          Foreground="{StaticResource TextPrimaryBrush}" Visibility="Collapsed"/>

                <Button x:Name="RefreshButton" Grid.Column="1" Content="🔄" Width="40" Height="36"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" FontSize="16" Padding="0"
                        Click="RefreshButton_Click"/>

                <Button x:Name="ConnectButton" Grid.Column="2" Content="Connect" Width="110" Height="36"
                        Style="{StaticResource FlatButton}" Click="ConnectButton_Click" FontSize="14" Padding="16,0"/>
            </Grid>
        </Border>

        <!-- ==================== TABS ==================== -->
        <TabControl Grid.Row="3" Style="{StaticResource DarkTabControl}">
            <TabItem Header="Control">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>     <!-- Relay list -->
                        <RowDefinition Height="Auto"/>  <!-- Bottom actions -->
                    </Grid.RowDefinitions>

                    <!-- Relay cards are added to RelayListPanel programmatically in
                         MainWindow.xaml.cs so toggle wiring and numbering stay in one place. -->
                    <UniformGrid Grid.Row="0" x:Name="RelayListPanel" Columns="2" VerticalAlignment="Top"/>

                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="AllOnButton" Grid.Column="0" Content="Turn all ON"
                                Style="{StaticResource FlatButton}" Background="{StaticResource OnBrush}"
                                Height="48" Click="AllOnButton_Click" FontSize="16" Padding="20,0"/>

                        <Button x:Name="AllOffButton" Grid.Column="2" Content="Turn all OFF"
                                Style="{StaticResource SecondaryButton}" Height="48"
                                Click="AllOffButton_Click" FontSize="16" Padding="20,0"/>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Presets">
                <!-- PresetsView is created in MainWindow.xaml.cs (needs the preset list and callbacks) -->
                <Grid x:Name="PresetsHost"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
