<UserControl x:Class="RelayControlWPF.Presets.PresetEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Title -->
            <RowDefinition Height="Auto"/>  <!-- Name field -->
            <RowDefinition Height="Auto"/>  <!-- Steps header -->
            <RowDefinition Height="*"/>     <!-- Steps list -->
            <RowDefinition Height="Auto"/>  <!-- Actions -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleTextBlock" Text="Preset" Style="{StaticResource RelayNameText}" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Name" Style="{StaticResource SubtitleText}" Margin="0,0,0,6"/>
            <TextBox x:Name="NameTextBox" Style="{StaticResource DarkTextBox}"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Text="Steps (run in order, top to bottom)" Style="{StaticResource SubtitleText}" Margin="0,0,0,8"/>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
            <StackPanel x:Name="StepsPanel">
                <!-- Step rows are built programmatically in PresetEditorView.xaml.cs -->
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="4">
            <Button DockPanel.Dock="Right" x:Name="SaveButton" Content="Save" Style="{StaticResource FlatButton}"
                    Height="40" Width="100" Padding="0" Click="SaveButton_Click"/>
            <Button DockPanel.Dock="Right" x:Name="CancelButton" Content="Cancel" Style="{StaticResource SecondaryButton}"
                    Height="40" Width="100" Padding="0" Margin="0,0,10,0" Click="CancelButton_Click"/>
            <Button x:Name="AddStepButton" Content="+ Add Step" Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Left" Height="40" Padding="18,0" Click="AddStepButton_Click"/>
        </DockPanel>
    </Grid>
</UserControl>
